{
  "name": "my-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/build-test.mjs && playwright test",
    "test:a11y": "node tests/e2e/build-test.mjs && playwright test tests/e2e/a11y.spec.ts",
    "test:static": "html-validate \"dist/**/*.html\" && node tests/static/check-dist.mjs",
    "test:all": "bun run build && bun run test && bun run test:static && bun run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.6",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "astro": "^5.2.5",
    "astro-icon": "^1.1.5",
    "emailjs-com": "^3.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@pandacss/dev": "^0.52.0",
    "@playwright/test": "^1.65.1",
    "html-validate": "^11.21.1",
    "vitest": "^5.1.1"
  }
}