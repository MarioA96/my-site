---
import HeroNavbar from './landing-page/hero/HeroNavbar.astro';
import Header from './landing-page/hero/Header.astro';

import TrailContent from './landing-page/hero/TrailContent.astro';

import WhatAboutSection from './landing-page/what-about/WhatAboutSection.astro';

import MyProjectsSection from './landing-page/my-projects/MyProjectsSection.astro';

import ContactSection from './landing-page/contact/ContactSection.astro';

import AdditionalInfo from './landing-page/additional-info/AdditionalInfo.astro';

import { css, cva, cx } from '../../styled-system/css';

const ContainerNavbarStyles = cva({
	base: {
		display: 'flex',
		position: {
			xsm: 'fixed',
			md: 'sticky'
		},
		bottom: {
			xsm: '0',
			md: 'inherit'
		},
		top: {
			xsm: 'inherit',
			md: '0'
		},
	},
})
---

<div id="container">
	<a href="#main-content" class="skip-link">Saltar al contenido principal</a>
	<main id="main-content" class="bg-[#161515] flex flex-col h-fit w-full">

		<div id="container-navbar" class:list={["h-fit w-full", ContainerNavbarStyles({})]}>
			<HeroNavbar />
		</div>

		<section id="hero" class="flex w-full h-fit bg-[#161515] order-1">
			<Header/>
		</section>

		<section id="my-stack-trail" class="flex mt-2 md:mt-8 w-full h-fit justify-center bg-[#161515] order-2">
			<TrailContent />
		</section>

		<section id="what-about" class="flex w-full h-fit bg-[#161515] justify-center order-3">
			<WhatAboutSection />
		</section>

		<section id="my-projects" class="flex w-full h-fit bg-[#161515] justify-center order-4">
			<MyProjectsSection />
		</section>

		<section id="my-contact" class="flex w-full h-fit bg-[#161515] justify-center order-5">
			<ContactSection />
		</section>

		<section id="additional-info" class="flex w-full h-fit bg-[#161515] order-6">
			<AdditionalInfo />
		</section>

		<footer id="footer" class="flex w-full h-fit order-7 justify-center">
			<div class="footer_content__box" class:list={["flex align-middle", css({ height: 'fit-content', width: { xsm: '70%', md: 'fit-content' } })]}>
				<div class={cx( css({ width: '100%', height: 'fit-content', color: '#888888', fontFamily: 'ubuntu_light', fontSize: '15px' }) )}>
					Based on <span class="inline-block text-[#c084fc] w-fit h-fit cursor-pointer"><a href="https://oscarhernandez.vercel.app/" target="_blank" rel="noopener">Oscar Hernandez design</a></span> copyright © 2025 replicated and modified from the scratch by Mario A. Q. S. All rights reserved.
				</div>
			</div>
		</footer>

	</main>
</div>

<style>
	@reference "../styles/global.css";

	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		z-index: 100;
		padding: 10px 16px;
		background: #a855f7;
		color: #101010;
		font-weight: 600;
		border-radius: 0 0 8px 0;
	}
	.skip-link:focus {
		left: 0;
	}

	a:focus-visible,
	button:focus-visible,
	summary:focus-visible,
	input:focus-visible,
	textarea:focus-visible {
		outline: 2px solid #a476ff;
		outline-offset: 2px;
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		height: fit-content;
	}

	section {
		scroll-margin-top: 80px; /* Ajusta según la altura de tu navbar */
	}

	#hero {
		@apply mb-5;
		justify-content: center;
	}

	#what-about {
		@apply mt-20
	}

	#my-projects {
		@apply mt-14;
	}

	#my-contact {
		@apply mt-40;
	}

	#additional-info {
		justify-content: center;
		@apply mt-10;
	}

	#footer {
		@apply mt-15 mb-30;
	}
</style>